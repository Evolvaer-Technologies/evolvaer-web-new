---
// src/pages/what-we-do.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pipeline = [
  { 
    num: "01", 
    name: "Explore", 
    tagline: "Horizon Scanning", 
    desc: "Horizon scanning and problem domain validation. We test technical feasibility against market realities before writing a single line of production code.",
    metrics: ["99.4% Domain Fit", "12-Factor Audit"],
    accent: "#2563EB" 
  },
  { 
    num: "02", 
    name: "Research", 
    tagline: "Computational Modeling", 
    desc: "Deep computational modeling, security architectures, and core system constraints mapping to de-risk complex technical execution.",
    metrics: ["Sub-ms Latency", "Zero-Trust Mesh"],
    accent: "#7C3AED" 
  },
  { 
    num: "03", 
    name: "Engineer", 
    tagline: "Rigorous Prototyping", 
    desc: "Rigorous prototyping and technical implementation using type-safe, multi-tenant cloud fabrics with extreme performance benchmarks.",
    metrics: ["100% Type Safe", "Edge Native"],
    accent: "#22D3EE" 
  },
  { 
    num: "04", 
    name: "Build", 
    tagline: "Production Deployment", 
    desc: "Production deployment with enterprise-grade resilience, automated CI/CD pipelines, and rigorous observability protocols.",
    metrics: ["99.999% Uptime", "Auto Rollback"],
    accent: "#A855F7" 
  },
  { 
    num: "05", 
    name: "Scale", 
    tagline: "Infrastructure Growth", 
    desc: "Operational optimization, horizontal scaling, and infrastructure governance to handle multi-region enterprise traffic spikes effortlessly.",
    metrics: ["Auto-Scaling", "Global CDN"],
    accent: "#F97316" 
  },
  { 
    num: "06", 
    name: "Impact", 
    tagline: "Value Delivery", 
    desc: "Measurable commercial and technological value delivery, turning validated technical frameworks into standalone revenue-ready platforms.",
    metrics: ["Max ROI", "Durable IP"],
    accent: "#10B981" 
  },
];
---

<BaseLayout 
  title="What We Do | Evolvaer Technologies" 
  description="Our 6-stage engineering and innovation pipeline: Explore, Research, Engineer, Build, Scale, and Impact."
>
  <Navbar />

  <main class="wwd-root">
    <!-- 1. HERO ARCHITECTURE -->
    <section class="wwd-hero">
      <div class="ambient-glow-left"></div>
      <div class="ambient-glow-right"></div>
      
      <div class="container hero-layout">
        <div class="hero-content">
          <div class="badge-pill">
            <span class="badge-dot"></span>
            <span>Continuous Engineering System v4.2</span>
          </div>
          <h1>
            From nascent theory to<br />
            <span class="gradient-text">high-impact reality.</span>
          </h1>
          <p class="lead-text">
            We bridge the chasm between deep computational exploration and production-grade software execution. Our rigorous 6-stage lifecycle ensures every technical investment translates into durable real-world value.
          </p>
          <div class="hero-actions">
            <a href="#pipeline" class="btn-primary">
              <span>Explore Methodology</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M19 12l-7 7-7-12"/></svg>
            </a>
            <a href="/contact" class="btn-outline">Initiate Project</a>
          </div>
        </div>

        <!-- System Telemetry HUD -->
        <div class="telemetry-hud">
          <div class="hud-header">
            <div class="hud-dots"><span></span><span></span><span></span></div>
            <span class="hud-title">sys_kernel::telemetry</span>
            <span class="hud-status-badge">ONLINE</span>
          </div>
          <div class="hud-body">
            <div class="hud-metric-row">
              <span class="hud-label">pipeline_state</span>
              <span class="hud-val c-teal">synchronized</span>
            </div>
            <div class="hud-metric-row">
              <span class="hud-label">execution_loop</span>
              <span class="hud-val c-blue">active_continuous</span>
            </div>
            <div class="hud-metric-row">
              <span class="hud-label">error_rate</span>
              <span class="hud-val c-green">0.000%</span>
            </div>
            <div class="hud-divider"></div>
            <div class="hud-stage-ticker">
              <span class="ticker-label">ACTIVE STAGES:</span>
              <div class="ticker-badges">
                {pipeline.map(p => (
                  <span class="ticker-badge" style={`border-color: ${p.accent}40; color: ${p.accent};`}>
                    {p.num} {p.name}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. THE 6-STAGE PIPELINE MATRIX -->
    <section id="pipeline" class="section pipeline-section">
      <div class="container">
        <div class="section-intro">
          <div>
            <div class="tag-row">
              <span class="mono-num">01-06</span>
              <span class="line-blue"></span>
              <span class="tag-text">End-to-End Architecture</span>
            </div>
            <h2>The Six-Stage <span class="gradient-text">Execution Grid.</span></h2>
          </div>
          <p class="subhead">Rather than isolated silos, our capabilities operate as a unified continuous loop where empirical data dictates iterative growth.</p>
        </div>

        <!-- Scrollable Mobile Track / Desktop Grid Wrapper -->
        <div class="pipeline-viewport">
          <div class="pipeline-grid">
            {pipeline.map((stage) => (
              <div class="stage-card" style={`--accent-color: ${stage.accent};`}>
                <div class="stage-header">
                  <span class="stage-num">{stage.num}</span>
                  <span class="stage-tagline">{stage.tagline}</span>
                </div>
                <div class="stage-body">
                  <h3>{stage.name}</h3>
                  <p>{stage.desc}</p>
                </div>
                <div class="stage-footer">
                  {stage.metrics.map(m => (
                    <span class="metric-pill">{m}</span>
                  ))}
                </div>
                <div class="stage-glow"></div>
              </div>
            ))}
          </div>
        </div>
        
        <div class="mobile-swipe-hint">
          <span>Swipe horizontally to navigate stages</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
      </div>
    </section>

    <!-- 3. SYSTEM THINKING & CAPABILITIES -->
    <section class="section surface-section border-y">
      <div class="container">
        <div class="grid-layout">
          <div class="sys-content">
            <span class="eyebrow">Integrated Systems</span>
            <h2>One continuous loop.<br />Not six disconnected hand-offs.</h2>
            <p class="body-text mt-4">
              Insights gained during the scale or impact phases immediately loop back to inform early-stage research and exploration. This cyclical resilience guarantees our technology stacks never drift from absolute practical utility.
            </p>
            <div class="mt-8 flex gap-4 flex-wrap">
              <a href="/research" class="btn-outline">Read Our Research →</a>
              <a href="/ventures" class="btn-outline">View Ventures ↗</a>
            </div>
          </div>

          <div class="sys-stack">
            <div class="sys-item">
              <div class="sys-num-box c-blue-bg">01</div>
              <div>
                <h4>Horizon Scanning & Validation</h4>
                <p>Validating problem domains and testing structural integrity before writing production code.</p>
              </div>
            </div>
            <div class="sys-item">
              <div class="sys-num-box c-teal-bg">02</div>
              <div>
                <h4>Resilient Cloud Implementation</h4>
                <p>Deploying type-safe, multi-tenant cloud fabrics built for high-concurrency environments.</p>
              </div>
            </div>
            <div class="sys-item">
              <div class="sys-num-box c-violet-bg">03</div>
              <div>
                <h4>Durable Commercial Scaling</h4>
                <p>Incubating validated architectures into independent, revenue-ready production ecosystems.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. BOTTOM ACTION CTA -->
    <section class="cta-section">
      <div class="cta-glow"></div>
      <div class="container cta-container">
        <div class="max-w-2xl">
          <span class="cta-eyebrow">Evolvaer Technologies</span>
          <h2 class="cta-heading">Ready to engineer what <span class="gradient-text">comes next?</span></h2>
          <p class="cta-sub">Initiate a confidential technical consultation or review our active research frameworks today.</p>
        </div>
        <div class="flex gap-4 flex-wrap">
          <a href="/contact" class="btn-primary">
            <span>Initiate Project</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/research" class="btn-outline-light">View Research ↗</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Base Layout & Tokens */
  .container { max-width: 1240px; margin: 0 auto; padding: 0 1.5rem; }
  .section { padding-top: 7rem; padding-bottom: 7rem; position: relative; }
  .surface-section { background-color: var(--color-surface, #0b0f19); }
  .border-y { border-top: 1px solid var(--color-border, rgba(255,255,255,0.08)); border-bottom: 1px solid var(--color-border, rgba(255,255,255,0.08)); }

  .text-muted { color: var(--color-text-muted, #94a3b8); }
  .tag-row { display: inline-flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .tag-text { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; color: var(--color-text-muted, #94a3b8); }
  .mono-num { font-family: ui-monospace, monospace; font-size: 0.75rem; color: var(--color-primary, #2563eb); }
  .line-blue { width: 2.5rem; height: 1px; background-color: var(--color-primary, #2563eb); opacity: 0.6; }
  
  .eyebrow { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; color: #22d3ee; display: block; margin-bottom: 1rem; }
  .gradient-text { background: linear-gradient(135deg, #60a5fa 0%, #22d3ee 50%, #c084fc 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

  h1 { font-size: clamp(2.6rem, 5.5vw, 5.2rem); font-weight: 800; line-height: 1.05; letter-spacing: -0.04em; margin: 1rem 0; color: #fff; }
  h2 { font-size: clamp(2rem, 3.8vw, 3.4rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.12; color: #fff; }
  .lead-text { font-size: 1.05rem; color: #94a3b8; line-height: 1.8; margin-bottom: 2.5rem; max-width: 620px; }
  .body-text { font-size: 0.95rem; color: #94a3b8; line-height: 1.75; }
  .subhead { font-size: 1.05rem; color: #94a3b8; line-height: 1.75; max-width: 540px; }

  /* Hero Section */
  .wwd-hero { position: relative; padding-top: 8rem; padding-bottom: 7rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); overflow: hidden; background: radial-gradient(circle at 50% 0%, rgba(37,99,235,0.08) 0%, transparent 60%); }
  .ambient-glow-left { position: absolute; left: -10%; top: 10%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(37,99,235,0.05) 0%, transparent 70%); filter: blur(120px); pointer-events: none; }
  .ambient-glow-right { position: absolute; right: -10%; bottom: 10%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(124,58,237,0.05) 0%, transparent 70%); filter: blur(120px); pointer-events: none; }
  
  .hero-layout { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 4rem; align-items: center; position: relative; z-index: 2; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  .badge-pill { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.85rem; border-radius: 9999px; background: rgba(37, 99, 235, 0.1); border: 1px solid rgba(37, 99, 235, 0.25); font-size: 0.75rem; font-weight: 600; color: #60a5fa; font-family: ui-monospace, monospace; }
  .badge-dot { width: 6px; height: 6px; border-radius: 50%; background: #22d3ee; box-shadow: 0 0 8px #22d3ee; }

  /* Telemetry HUD Widget */
  .telemetry-hud { background: #060911; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px; overflow: hidden; box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.6); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; position: relative; }
  .telemetry-hud::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, #2563eb, #22d3ee, #7c3acked); }
  .hud-header { background: rgba(255, 255, 255, 0.02); border-bottom: 1px solid rgba(255, 255, 255, 0.06); padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; }
  .hud-dots { display: flex; gap: 6px; }
  .hud-dots span { width: 8px; height: 8px; border-radius: 50%; background: rgba(255, 255, 255, 0.15); }
  .hud-title { font-size: 0.75rem; color: rgba(255, 255, 255, 0.4); }
  .hud-status-badge { font-size: 0.65rem; padding: 0.15rem 0.5rem; border-radius: 4px; background: rgba(16, 185, 129, 0.15); color: #10b981; font-weight: bold; border: 1px solid rgba(16, 185, 129, 0.3); }
  
  .hud-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.85rem; }
  .hud-metric-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; }
  .hud-label { color: rgba(255, 255, 255, 0.5); }
  .c-teal { color: #22d3ee; }
  .c-blue { color: #60a5fa; }
  .c-green { color: #10b981; }
  
  .hud-divider { height: 1px; background: rgba(255, 255, 255, 0.06); margin: 0.5rem 0; }
  .hud-stage-ticker { display: flex; flex-direction: column; gap: 0.5rem; }
  .ticker-label { font-size: 0.65rem; color: rgba(255, 255, 255, 0.3); letter-spacing: 0.1em; }
  .ticker-badges { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .ticker-badge { font-size: 0.68rem; padding: 0.2rem 0.5rem; border-radius: 4px; border: 1px solid; background: rgba(255,255,255,0.02); }

  /* Pipeline Grid */
  .pipeline-section { background: linear-gradient(180deg, transparent 0%, rgba(37,99,235,0.02) 100%); }
  .section-intro { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3.5rem; gap: 2rem; flex-wrap: wrap; }
  
  .pipeline-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
  .stage-card { position: relative; background: #080d18; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; padding: 2.25rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1); overflow: hidden; }
  .stage-card:hover { transform: translateY(-6px); border-color: var(--accent-color); box-shadow: 0 20px 40px -15px rgba(0,0,0,0.7), 0 0 20px -5px var(--accent-color); }
  
  .stage-header { display: flex; justify-content: space-between; align-items: center; }
  .stage-num { font-family: ui-monospace, monospace; font-size: 1.2rem; font-weight: 800; color: var(--accent-color); }
  .stage-tagline { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(255, 255, 255, 0.4); padding: 0.2rem 0.6rem; border-radius: 99px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); }
  
  .stage-body h3 { font-size: 1.35rem; font-weight: 700; color: #fff; margin-bottom: 0.6rem; }
  .stage-body p { font-size: 0.88rem; color: #94a3b8; line-height: 1.65; }
  
  .stage-footer { display: flex; gap: 0.5rem; flex-wrap: wrap; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.06); }
  .metric-pill { font-size: 0.68rem; font-family: ui-monospace, monospace; padding: 0.2rem 0.55rem; border-radius: 6px; background: rgba(255, 255, 255, 0.03); color: #cbd5e1; border: 1px solid rgba(255, 255, 255, 0.06); }
  
  .stage-glow { position: absolute; top: 0; right: 0; width: 150px; height: 150px; background: radial-gradient(circle, var(--accent-color) 0%, transparent 70%); opacity: 0.05; filter: blur(30px); pointer-events: none; transition: opacity 0.3s ease; }
  .stage-card:hover .stage-glow { opacity: 0.15; }

  .mobile-swipe-hint { display: none; }

  /* System Stack Section */
  .grid-layout { display: grid; grid-template-columns: 1fr 1.1fr; gap: 5rem; align-items: center; }
  .sys-stack { display: flex; flex-direction: column; gap: 1.25rem; }
  .sys-item { display: flex; gap: 1.5rem; padding: 1.75rem; background: #080d18; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; align-items: flex-start; transition: border-color 0.2s ease; }
  .sys-item:hover { border-color: rgba(255, 255, 255, 0.2); }
  
  .sys-num-box { font-family: ui-monospace, monospace; font-size: 0.85rem; font-weight: 800; width: 2.75rem; height: 2.75rem; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .c-blue-bg { background: rgba(37,99,235,0.15); color: #60a5fa; border: 1px solid rgba(37,99,235,0.3); }
  .c-teal-bg { background: rgba(34,211,238,0.15); color: #22d3ee; border: 1px solid rgba(34,211,238,0.3); }
  .c-violet-bg { background: rgba(124,58,237,0.15); color: #c084fc; border: 1px solid rgba(124,58,237,0.3); }
  
  .sys-item h4 { font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 0.35rem; }
  .sys-item p { font-size: 0.85rem; color: #94a3b8; line-height: 1.6; }

  /* Bottom CTA Section */
  .cta-section { position: relative; padding: 7rem 0; background: #04070d; border-top: 1px solid rgba(255, 255, 255, 0.08); overflow: hidden; }
  .cta-glow { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); width: 800px; height: 300px; background: radial-gradient(circle, rgba(37,99,235,0.12) 0%, transparent 70%); filter: blur(80px); pointer-events: none; }
  .cta-container { display: flex; justify-content: space-between; align-items: center; gap: 3rem; position: relative; z-index: 2; }
  .cta-eyebrow { font-size: 0.65rem; font-family: ui-monospace, monospace; text-transform: uppercase; letter-spacing: 0.25rem; color: #22d3ee; display: block; margin-bottom: 0.75rem; }
  .cta-heading { font-size: clamp(2.2rem, 3.5vw, 3.2rem); font-weight: 800; letter-spacing: -0.03em; color: #fff; line-height: 1.15; margin-bottom: 0.75rem; }
  .cta-sub { font-size: 0.95rem; color: #94a3b8; }

  /* Buttons */
  .btn-primary { background-color: #2563eb; color: #ffffff !important; padding: 0.85rem 2rem; border-radius: 9999px; font-size: 0.9rem; font-weight: 600; transition: all 0.25s ease; display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; box-shadow: 0 4px 14px rgba(37,99,235,0.4); }
  .btn-primary:hover { background-color: #1d4ed8; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(37,99,235,0.6); }
  
  .btn-outline { border: 1px solid rgba(255, 255, 255, 0.15); color: #fff !important; padding: 0.85rem 2rem; border-radius: 9999px; font-size: 0.9rem; font-weight: 600; background-color: rgba(255, 255, 255, 0.02); display: inline-flex; align-items: center; text-decoration: none; transition: all 0.25s ease; }
  .btn-outline:hover { border-color: #2563eb; background-color: rgba(37, 99, 235, 0.05); }
  
  .btn-outline-light { border: 1px solid rgba(255, 255, 255, 0.2); color: #ffffff !important; padding: 0.85rem 2rem; border-radius: 9999px; font-size: 0.9rem; font-weight: 600; display: inline-flex; align-items: center; text-decoration: none; transition: background-color 0.2s; background: rgba(255,255,255,0.03); }
  .btn-outline-light:hover { background-color: rgba(255, 255, 255, 0.08); }

  /* Responsive / Compact Mobile Card Adjustments */
  @media (max-width: 1024px) {
    .pipeline-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero-layout, .grid-layout { grid-template-columns: 1fr; gap: 3rem; }
    .telemetry-hud { display: none; }
    .cta-container { flex-direction: column; align-items: flex-start; }

    /* Compact Mobile Swipe Track */
    .pipeline-viewport {
      width: 100vw;
      margin-left: -1.5rem;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      scroll-snap-type: x mandatory;
    }
    .pipeline-viewport::-webkit-scrollbar {
      display: none;
    }

    .pipeline-grid {
      display: flex;
      gap: 0.85rem;
      width: max-content;
      padding-bottom: 0.5rem;
    }

    /* Smaller, tighter card dimensions tailored for thumb usage */
    .stage-card {
      width: 235px;
      flex-shrink: 0;
      scroll-snap-align: start;
      padding: 1.25rem;
      gap: 0.85rem;
      border-radius: 14px;
    }

    .stage-num {
      font-size: 1rem;
    }

    .stage-tagline {
      font-size: 0.6rem;
      padding: 0.15rem 0.45rem;
      letter-spacing: 0.08em;
    }

    .stage-body h3 {
      font-size: 1.15rem;
      margin-bottom: 0.35rem;
    }

    .stage-body p {
      font-size: 0.8rem;
      line-height: 1.5;
    }

    .stage-footer {
      padding-top: 0.75rem;
      gap: 0.35rem;
    }

    .metric-pill {
      font-size: 0.62rem;
      padding: 0.15rem 0.45rem;
    }

    .mobile-swipe-hint {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1rem;
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.4);
      font-family: ui-monospace, monospace;
    }
  }
</style>