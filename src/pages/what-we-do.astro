---
// src/pages/what-we-do.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pipeline = [
  { 
    num: "01", 
    tag: "Explore", 
    title: "Horizon Scanning", 
    desc: "Problem domain validation. We test technical feasibility against market realities before writing a single line of production code.",
    accent: "var(--color-primary)" 
  },
  { 
    num: "02", 
    tag: "Research", 
    title: "Computational Modeling", 
    desc: "Deep computational modeling, security architectures, and core system constraints mapping to de-risk complex technical execution.",
    accent: "var(--color-teal)" 
  },
  { 
    num: "03", 
    tag: "Engineer", 
    title: "Rigorous Prototyping", 
    desc: "Rigorous prototyping and technical implementation using type-safe, multi-tenant cloud fabrics with extreme performance benchmarks.",
    accent: "var(--color-violet)" 
  },
  { 
    num: "04", 
    tag: "Build", 
    title: "Production Deployment", 
    desc: "Production deployment with enterprise-grade resilience, automated CI/CD pipelines, and rigorous observability protocols.",
    accent: "var(--color-primary)" 
  },
  { 
    num: "05", 
    tag: "Scale", 
    title: "Infrastructure Growth", 
    desc: "Operational optimization, horizontal scaling, and infrastructure governance to handle multi-region enterprise traffic spikes effortlessly.",
    accent: "var(--color-teal)" 
  },
  { 
    num: "06", 
    tag: "Impact", 
    title: "Value Delivery", 
    desc: "Measurable commercial and technological value delivery, turning validated technical frameworks into standalone revenue-ready platforms.",
    accent: "var(--color-violet)" 
  },
];

const coreDomains = [
  { domain: "Distributed Architectures", stack: "Node.js · TypeScript · Isolated Multi-Tenancy" },
  { domain: "Scientific Intelligence", stack: "Python · PyTorch · Semantic Transformer Embeddings" },
  { domain: "Zero-Overhead Web Fabrics", stack: "Astro · Static Edge Delivery · Vanilla CSS Tokens" }
];
---

<BaseLayout 
  title="What We Do | Evolvaer Technologies" 
  description="Our 6-stage engineering and innovation pipeline: Explore, Research, Engineer, Build, Scale, and Impact."
>
  <Navbar />

  <main class="wwd-root">
    <!-- 1. HERO SECTION -->
    <section class="wwd-hero bg-grid">
      <div class="ambient-glow"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="badge-row">
            <span class="pulse-dot"></span>
            <span class="badge-label">Continuous Engineering System</span>
          </div>
          <h1>
            From nascent theory to<br />
            <span class="gradient-text">high-impact reality.</span>
          </h1>
          <p class="lead">
            We bridge the chasm between deep computational exploration and production-grade software execution. Our rigorous 6-stage lifecycle ensures every technical investment translates into durable real-world value.
          </p>
          <div class="cta-cluster">
            <a href="#pipeline" class="btn-primary">Explore Methodology</a>
            <a href="/contact" class="btn-outline">Initiate Project</a>
          </div>
        </div>

        <!-- Telemetry Terminal Card -->
        <div class="terminal-card">
          <div class="terminal-header">
            <div class="dots"><span></span><span></span><span></span></div>
            <span class="terminal-title">evolvaer_sys::runtime_matrix</span>
          </div>
          <div class="terminal-body">
            <p class="code-line"><span class="c-teal">const</span> executionMode = <span class="c-blue">'continuous_loop'</span>;</p>
            <p class="code-line"><span class="c-teal">const</span> stages = [<span class="c-violet">'Explore'</span>, <span class="c-violet">'Research'</span>, <span class="c-violet">'Engineer'</span>, <span class="c-violet">'Build'</span>];</p>
            <div class="terminal-divider"></div>
            <p class="term-status">> PIPELINE_CAPABILITY_MATRIX:</p>
            {coreDomains.map(d => (
              <div class="domain-row">
                <span class="domain-title">{d.domain}</span>
                <span class="domain-stack">{d.stack}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. THE 6-STAGE PIPELINE MATRIX -->
    <section id="pipeline" class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">End-to-End Architecture</span>
          <h2>The Six-Stage Execution Grid.</h2>
          <p class="subhead">Rather than isolated silos, our capabilities operate as a unified continuous loop where empirical data dictates iterative growth.</p>
        </div>

        <div class="pillars-grid">
          {pipeline.map(p => (
            <div class="pillar-card">
              <span class="pillar-num" style={`color: ${p.accent}; border-color: ${p.accent}33;`}>{p.num}</span>
              <span class="pillar-tag" style={`color: ${p.accent};`}>{p.tag}</span>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. SYSTEM THINKING -->
    <section class="section surface-bg border-y">
      <div class="container">
        <div class="section-head text-center">
          <span class="eyebrow">Integrated Systems</span>
          <h2>One continuous loop.<br />Not six disconnected hand-offs.</h2>
          <p class="subhead mx-auto">Insights gained during the scale or impact phases immediately loop back to inform early-stage research and exploration.</p>
        </div>

        <div class="lifecycle-track">
          <div class="track-step">
            <div class="step-num">01</div>
            <h4>Horizon Scanning</h4>
            <p>Validating problem domains and testing structural integrity before writing production code.</p>
          </div>
          <div class="track-step">
            <div class="step-num">02</div>
            <h4>Resilient Cloud Implementation</h4>
            <p>Deploying type-safe, multi-tenant cloud fabrics built for high-concurrency environments.</p>
          </div>
          <div class="track-step">
            <div class="step-num">03</div>
            <h4>Durable Commercial Scaling</h4>
            <p>Incubating validated architectures into independent, revenue-ready production ecosystems.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. BOTTOM ACTION CTA -->
    <section class="section text-center">
      <div class="container cta-container">
        <div>
          <span class="eyebrow">Evolvaer Technologies</span>
          <h2 class="mb-4">Ready to engineer what <span class="gradient-text">comes next?</span></h2>
          <p class="subhead mx-auto mb-8">Initiate a confidential technical consultation or review our active research frameworks.</p>
        </div>
        <div class="cta-cluster justify-center">
          <a href="/contact" class="btn-primary">Initiate Project →</a>
          <a href="/research" class="btn-outline">View Research ↗</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .wwd-root {
    min-height: 100vh;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .section {
    padding: 6rem 0;
  }
  .surface-bg {
    background-color: var(--color-surface);
  }
  .border-y {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  /* Typography Utilities */
  .eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-teal);
    display: block;
    margin-bottom: 0.6rem;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-teal) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .section-head {
    max-width: 720px;
    margin-bottom: 3.5rem;
  }
  .section-head.text-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }
  .section-head h2 {
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .subhead {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-top: 0.75rem;
  }
  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }
  .mb-4 { margin-bottom: 1rem; }
  .mb-8 { margin-bottom: 2rem; }

  /* 1. Hero Layout */
  .wwd-hero {
    position: relative;
    padding-top: 6.5rem;
    padding-bottom: 5.5rem;
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3.5rem;
    align-items: center;
  }
  .badge-row {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
  }
  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-teal);
    box-shadow: 0 0 10px var(--color-teal);
  }
  .badge-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }
  .hero-copy h1 {
    font-size: clamp(2.6rem, 4.5vw, 4.4rem);
    font-weight: var(--weight-bold);
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
  }
  .lead {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 2rem;
  }
  .cta-cluster {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cta-cluster.justify-center {
    justify-content: center;
  }

  /* Terminal Card */
  .terminal-card {
    background: #080c14;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  .terminal-header {
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }
  .terminal-title {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.05em;
  }
  .terminal-body {
    padding: 1.5rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: #e2e8f0;
  }
  .code-line { margin-bottom: 0.4rem; }
  .c-teal { color: #22d3ee; }
  .c-blue { color: #60a5fa; }
  .c-violet { color: #c084fc; }
  .terminal-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin: 1.25rem 0;
  }
  .term-status {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 0.75rem;
  }
  .domain-row {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.75rem;
    padding-left: 0.75rem;
    border-left: 2px solid #22d3ee;
  }
  .domain-title {
    font-weight: bold;
    font-size: 0.8rem;
    color: #f8fafc;
  }
  .domain-stack {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.5);
  }

  /* 2. Pillars Grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }
  .pillar-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .pillar-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
  }
  .pillar-num {
    font-family: monospace;
    font-size: var(--text-xs);
    font-weight: bold;
    border: 1px solid;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pillar-tag {
    font-size: var(--text-xs);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-top: 0.5rem;
  }
  .pillar-card h3 {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
  }
  .pillar-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  /* 3. Lifecycle Track */
  .lifecycle-track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .track-step {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .step-num {
    font-family: monospace;
    font-size: var(--text-xs);
    font-weight: bold;
    color: var(--color-teal);
  }
  .track-step h4 {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
  }
  .track-step p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Buttons */
  .btn-primary {
    background: var(--color-primary);
    color: #fff !important;
    padding: 0.75rem 1.6rem;
    border-radius: 6px;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    display: inline-flex;
    justify-content: center;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .btn-primary:hover { opacity: 0.92; }
  .btn-outline {
    background: var(--color-surface);
    color: var(--color-text-main);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1.6rem;
    border-radius: 6px;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .btn-outline:hover { border-color: var(--color-primary); }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
  }
</style>