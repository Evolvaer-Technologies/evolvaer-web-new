---
// src/pages/what-we-do.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pipeline = [
  { num: "01", name: "Explore", desc: "Horizon scanning and problem domain validation.", accent: "#2563EB" },
  { num: "02", name: "Research", desc: "Computational modeling, architectures, and feasibility.", accent: "#7C3AED" },
  { num: "03", name: "Engineer", desc: "Rigorous prototyping and technical implementation.", accent: "#22D3EE" },
  { num: "04", name: "Build", desc: "Production deployment with enterprise-grade resilience.", accent: "#A855F7" },
  { num: "05", name: "Scale", desc: "Operational optimization and infrastructure growth.", accent: "#F97316" },
  { num: "06", name: "Impact", desc: "Measurable commercial and technological value delivery.", accent: "#10B981" },
];
---

<BaseLayout 
  title="What We Do | Evolvaer Technologies" 
  description="Our 6-stage engineering and innovation pipeline: Explore, Research, Engineer, Build, Scale, and Impact."
>
  <Navbar />

  <main class="wwd-root">
    <!-- 1. HERO ARCHITECTURE -->
    <section class="wwd-hero bg-grid">
      <div class="ambient-glow"></div>
      <div class="container hero-layout">
        <div>
          <div class="tag-row">
            <span class="mono-num">SYSTEM</span>
            <span class="line-blue"></span>
            <span class="tag-text">End-to-End Pipeline</span>
          </div>
          <h1>
            From nascent theory to<br />
            <span class="gradient-text">high-impact reality.</span>
          </h1>
          <p class="lead-text">
            We bridge the chasm between deep computational exploration and production-grade software execution. Our 6-stage methodology ensures every technical investment translates into durable real-world value.
          </p>
          <div class="hero-actions">
            <a href="#pipeline" class="btn-primary">Explore Methodology ↓</a>
            <a href="/contact" class="btn-outline">Initiate Project</a>
          </div>
        </div>

        <!-- Telemetry Card -->
        <div class="telemetry-card">
          <div class="term-head">
            <div class="dots"><span></span><span></span><span></span></div>
            <span class="term-title">pipeline_execution::lifecycle</span>
          </div>
          <div class="term-content">
            <p><span class="c-blue">status:</span> active_deployment</p>
            <p><span class="c-teal">architecture:</span> zero_hydration_edge</p>
            <div class="term-rule"></div>
            <div class="pipeline-preview">
              {pipeline.slice(0, 4).map(p => (
                <div class="p-preview-row">
                  <span style={`color:${p.accent}`}>{p.num}</span>
                  <strong>{p.name}</strong>
                  <span class="p-preview-desc">{p.desc}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. THE 6-STAGE PIPELINE MATRIX -->
    <section id="pipeline" class="section border-b">
      <div class="container">
        <div class="section-intro">
          <div>
            <div class="tag-row">
              <span class="mono-num">01-06</span>
              <span class="line-blue"></span>
              <span class="tag-text">Methodology</span>
            </div>
            <h2>The Six-Stage <span class="gradient-text">Execution Grid.</span></h2>
          </div>
          <p class="subhead">Rather than isolated silos, our capabilities operate as a unified continuous loop where evidence dictates growth.</p>
        </div>

        <div class="pipeline-grid">
          {pipeline.map((stage) => (
            <div class="stage-card">
              <div class="stage-top">
                <span class="stage-num" style={`color:${stage.accent}; border-color:${stage.accent}40; background:${stage.accent}0A;`}>{stage.num}</span>
                <span class="pulse-dot" style={`background:${stage.accent}; box-shadow:0 0 10px ${stage.accent};`}></span>
              </div>
              <h3>{stage.name}</h3>
              <p>{stage.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. SYSTEM THINKING & CAPABILITIES -->
    <section class="section surface-bg border-b">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="eyebrow">Integrated Systems</span>
            <h2>One continuous loop.<br />Not six disconnected hand-offs.</h2>
            <p class="body-text mt-4">
              Learning in scale or impact immediately loops back to inform research or exploration. This cyclical resilience ensures our technology stacks never drift from absolute practical utility.
            </p>
            <div class="mt-8 flex gap-4 flex-wrap">
              <a href="/research" class="btn-outline">Read Our Research →</a>
              <a href="/ventures" class="btn-outline">View Ventures ↗</a>
            </div>
          </div>

          <div class="sys-stack">
            <div class="card p-6 bg-bg border-border">
              <span class="font-mono text-xs text-primary block mb-1">01 / DISCOVERY</span>
              <h4 class="text-lg font-semibold">Horizon Scanning & Validation</h4>
              <p class="text-xs text-muted mt-2">Validating problem domains before writing a single line of production code.</p>
            </div>
            <div class="card p-6 bg-bg border-border">
              <span class="font-mono text-xs text-teal block mb-1">02 / EXECUTION</span>
              <h4 class="text-lg font-semibold">Resilient Implementation</h4>
              <p class="text-xs text-muted mt-2">Deploying type-safe, multi-tenant cloud fabrics with extreme performance standards.</p>
            </div>
            <div class="card p-6 bg-bg border-border">
              <span class="font-mono text-xs text-violet block mb-1">03 / EVOLUTION</span>
              <h4 class="text-lg font-semibold">Durable Commercial Scaling</h4>
              <p class="text-xs text-muted mt-2">Incubating validated systems into independent, revenue-ready platforms.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. BOTTOM ACTION CTA -->
    <section class="section py-20 bg-[#07111D] text-white">
      <div class="container flex flex-wrap justify-between items-center gap-8">
        <div class="max-w-2xl">
          <span class="text-[0.5rem] font-mono uppercase tracking-widest text-[#67E8F9]">Evolvaer Technologies</span>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mt-2 text-white">Ready to engineer what <span class="gradient-text">comes next?</span></h2>
          <p class="text-sm text-white/60 mt-3">Initiate a confidential technical consultation or review our active research frameworks.</p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <a href="/contact" class="btn-primary">Initiate Project →</a>
          <a href="/research" class="btn-outline-light">View Research ↗</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Base Layout Tokens */
  .container { max-width: 1240px; margin: 0 auto; padding: 0 1.5rem; }
  .section { padding-top: 6rem; padding-bottom: 6rem; }
  .surface-bg { background-color: var(--color-surface); }
  .border-b { border-bottom: 1px solid var(--color-border); }
  
  .text-muted { color: var(--color-text-muted); }
  .text-primary { color: var(--color-primary); }
  .text-teal { color: var(--color-teal); }
  .text-violet { color: #7C3AED; }

  .tag-row { display: inline-flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem; }
  .tag-text { font-size: var(--text-xs); font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: 0.2em; color: var(--color-text-muted); }
  .mono-num { font-family: monospace; font-size: var(--text-xs); color: var(--color-primary); }
  .line-blue { width: 2rem; height: 1px; background-color: var(--color-primary); opacity: 0.5; }
  
  .eyebrow { font-size: var(--text-xs); font-weight: var(--weight-bold); text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-teal); display: block; margin-bottom: 0.75rem; }
  .gradient-text { background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-teal) 50%, #7C3AED 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

  h1 { font-size: clamp(2.8rem, 5vw, 5rem); font-weight: var(--weight-bold); line-height: 1.02; letter-spacing: -0.04em; margin: 0.75rem 0; }
  h2 { font-size: clamp(2rem, 3.5vw, 3.2rem); font-weight: var(--weight-bold); letter-spacing: -0.03em; line-height: 1.15; }
  .lead-text { font-size: var(--text-base); color: var(--color-text-muted); line-height: 1.75; margin-bottom: 2rem; max-width: 650px; }
  .body-text { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.7; }
  .subhead { font-size: var(--text-base); color: var(--color-text-muted); line-height: 1.7; }

  /* Hero Section */
  .wwd-hero { position: relative; padding-top: 7rem; padding-bottom: 6rem; border-bottom: 1px solid var(--color-border); overflow: hidden; }
  .ambient-glow { position: absolute; left: 50%; top: 20%; transform: translateX(-50%); width: 600px; height: 350px; background: radial-gradient(circle, rgba(37,99,235,0.06) 0%, transparent 70%); filter: blur(100px); pointer-events: none; }
  .hero-layout { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: center; position: relative; z-index: 2; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* Telemetry Card */
  .telemetry-card { background: #080c14; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 16px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
  .term-head { background: rgba(255, 255, 255, 0.03); border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding: 0.85rem 1.2rem; display: flex; align-items: center; gap: 1rem; }
  .dots { display: flex; gap: 6px; }
  .dots span { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); }
  .term-title { font-size: 0.75rem; color: rgba(255, 255, 255, 0.4); }
  .term-content { padding: 1.75rem; font-size: 0.84rem; line-height: 1.6; color: #e2e8f0; }
  .c-blue { color: #60a5fa; }
  .c-teal { color: #22d3ee; }
  .term-rule { height: 1px; background: rgba(255, 255, 255, 0.08); margin: 1.25rem 0; }
  .pipeline-preview { display: flex; flex-direction: column; gap: 0.75rem; }
  .p-preview-row { display: grid; grid-template-columns: 2rem 6rem 1fr; align-items: center; font-size: 0.75rem; }
  .p-preview-desc { color: rgba(255, 255, 255, 0.4); font-size: 0.7rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Pipeline Grid */
  .section-intro { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 3rem; align-items: flex-end; margin-bottom: 3.5rem; }
  .pipeline-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; }
  .stage-card { background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: 16px; padding: 2.5rem; display: flex; flex-direction: column; gap: 0.75rem; transition: transform 0.25s ease, border-color 0.25s ease; }
  .stage-card:hover { transform: translateY(-4px); border-color: var(--color-primary); }
  .stage-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
  .stage-num { font-family: monospace; font-size: var(--text-xs); font-weight: bold; width: 2.25rem; height: 2.25rem; border: 1px solid; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; }
  .stage-card h3 { font-size: var(--text-xl); font-weight: var(--weight-bold); }
  .stage-card p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.7; }

  /* System Stack */
  .sys-stack { display: flex; flex-direction: column; gap: 1rem; }
  .card { background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: 14px; }

  /* Buttons */
  .btn-primary { background-color: var(--color-primary); color: #ffffff !important; padding: 0.75rem 1.75rem; border-radius: 9999px; font-size: var(--text-sm); font-weight: var(--weight-semibold); transition: opacity 0.2s, transform 0.2s; display: inline-flex; align-items: center; text-decoration: none; }
  .btn-primary:hover { opacity: 0.92; transform: translateY(-1px); }
  .btn-outline { border: 1px solid var(--color-border); color: var(--color-text-main) !important; padding: 0.75rem 1.75rem; border-radius: 9999px; font-size: var(--text-sm); font-weight: var(--weight-semibold); background-color: var(--color-surface); display: inline-flex; align-items: center; text-decoration: none; transition: border-color 0.2s; }
  .btn-outline:hover { border-color: var(--color-primary); }
  .btn-outline-light { border: 1px solid rgba(255, 255, 255, 0.2); color: #ffffff !important; padding: 0.75rem 1.75rem; border-radius: 9999px; font-size: var(--text-sm); font-weight: var(--weight-semibold); display: inline-flex; align-items: center; text-decoration: none; transition: background-color 0.2s; }
  .btn-outline-light:hover { background-color: rgba(255, 255, 255, 0.08); }

  @media (max-width: 900px) {
    .hero-layout, .section-intro { grid-template-columns: 1px !important; grid-template-columns: 1fr; gap: 2rem; }
    .telemetry-card { display: none; }
  }
</style>