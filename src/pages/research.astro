---
// src/pages/research.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const tracks = [
  {
    id: "active",
    code: "RES-01",
    tag: "Active Inquiry",
    title: "AI-Assisted Communication Context",
    desc: "Investigating how transformer-based contextual embeddings improve real-time intent disambiguation where language or acoustics create friction.",
    accent: "var(--color-primary)",
    state: "In Progress",
    questions: [
      "Can localized context windows reliably predict communicative intent?",
      "Where must human judgement strictly supersede model inference?",
      "What interaction model introduces the least cognitive latency?"
    ]
  },
  {
    id: "applied",
    code: "RES-02",
    tag: "Applied Research",
    title: "Accessible Interaction Architectures",
    desc: "Designing adaptive software primitives that dynamically conform to varied user interaction styles instead of enforcing rigid, monolithic UI patterns.",
    accent: "var(--color-teal)",
    state: "Prototyping",
    questions: [
      "Which input channels minimize interaction resistance?",
      "How should probabilistic interfaces communicate uncertainty to the user?",
      "Can accessibility exist natively without post-hoc compatibility layers?"
    ]
  },
  {
    id: "trust",
    code: "RES-03",
    tag: "Trust & Safety",
    title: "Trustworthy Intelligent Systems",
    desc: "Formulating evaluation harnesses to audit model hallucinations, measure perspective alignment, and ensure interpretability during imperfect inference.",
    accent: "var(--color-violet)",
    state: "Evaluating",
    questions: [
      "How should confidence scores be mathematically presented to operators?",
      "When is deterministic fallback preferable to automated decisioning?",
      "How can empirical performance and user trust be measured concurrently?"
    ]
  }
];

const methodology = [
  { step: "01", name: "Observe", signal: "Signal", desc: "Detect computational shifts and emerging problem areas." },
  { step: "02", name: "Question", signal: "Hypothesis", desc: "Define explicit boundaries and stress-test assumptions." },
  { step: "03", name: "Investigate", signal: "Evidence", desc: "Execute empirical model experiments and runtime benchmarks." },
  { step: "04", name: "Apply", signal: "System", desc: "Harden validated insights into production platforms." }
];

const decisionMatrix = [
  { code: "GATE-A", action: "Re-investigate", condition: "Fundamental uncertainty remains unresolved", color: "var(--color-violet)" },
  { code: "GATE-B", action: "Prototype", condition: "Technical assumption demands hardware/runtime benchmark", color: "var(--color-primary)" },
  { code: "GATE-C", action: "Build & Deploy", condition: "Empirical evidence supports a resilient production system", color: "var(--color-teal)" },
  { code: "GATE-D", action: "Terminate", condition: "Evidence fails to justify computational overhead", color: "#64748B" }
];
---

<BaseLayout 
  title="Research | Evolvaer Technologies" 
  description="Selective computational research, linguistic alignment, and trustworthy machine learning architectures."
>
  <Navbar />

  <main class="research-page">
    <!-- 1. HEADER & EXPERIMENTAL MATRIX HERO -->
    <section class="research-hero bg-grid">
      <div class="ambient-glow"></div>
      <div class="container hero-layout">
        <div class="hero-text">
          <div class="tag-row">
            <span class="mono-badge">RSRCH // 01</span>
            <span class="tag-label">Empirical Investigation</span>
          </div>
          <h1>
            Researching questions that<br />
            <span class="gradient-text">demand better answers.</span>
          </h1>
          <p class="lead">
            We focus on selective computational inquiries: investigating intelligent interaction models, context-aware translation, and deterministic software fabrics.
          </p>
          <div class="hero-actions">
            <a href="#active-tracks" class="btn-primary">Inspect Active Tracks ↓</a>
            <a href="#decision-gates" class="btn-outline">Decision Protocol</a>
          </div>
        </div>

        <!-- Interactive Research Radar / Telemetry -->
        <div class="radar-card">
          <div class="radar-header">
            <span class="radar-live-dot"></span>
            <span class="radar-status">TELEMETRY // LAB_STATUS: ACTIVE</span>
            <span class="mono-date">2026.09</span>
          </div>
          <div class="radar-display">
            <div class="concentric-ring ring-1"></div>
            <div class="concentric-ring ring-2"></div>
            <div class="crosshair-v"></div>
            <div class="crosshair-h"></div>
            <div class="radar-node node-1" title="Model Alignment"><span>NLP</span></div>
            <div class="radar-node node-2" title="Zero-Runtime Client"><span>EDGE</span></div>
            <div class="radar-node node-3" title="Probabilistic UX"><span>UI</span></div>
          </div>
          <div class="radar-meta">
            <div><span>Primary Focus:</span> Semantic Embeddings</div>
            <div><span>Verification:</span> Empirical Benchmarks</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. ACTIVE RESEARCH WORKBENCH (WITH INSTANT JS FILTER) -->
    <section id="active-tracks" class="section">
      <div class="container">
        <div class="section-toolbar">
          <div>
            <span class="eyebrow">Portfolio Workbench</span>
            <h2>Active Investigations</h2>
          </div>
          <div class="filter-pills" id="track-filters">
            <button class="filter-btn active" data-filter="all">All Tracks</button>
            <button class="filter-btn" data-filter="active">Active</button>
            <button class="filter-btn" data-filter="applied">Applied</button>
            <button class="filter-btn" data-filter="trust">Trust</button>
          </div>
        </div>

        <div class="tracks-grid" id="tracks-grid">
          {tracks.map(t => (
            <article class="track-card" data-category={t.id} style={`--card-accent: ${t.accent};`}>
              <div class="track-card-header">
                <span class="track-code">{t.code}</span>
                <span class="track-state">{t.state}</span>
              </div>
              <span class="track-tag">{t.tag}</span>
              <h3>{t.title}</h3>
              <p class="track-desc">{t.desc}</p>
              
              <div class="questions-tray">
                <span class="tray-title">Core Research Inquiries:</span>
                <ul>
                  {t.questions.map((q, i) => (
                    <li>
                      <span class="q-num">0{i + 1}</span>
                      <span>{q}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. RESEARCH-TO-DECISION GATES -->
    <section id="decision-gates" class="section surface-bg border-y">
      <div class="container">
        <div class="section-header-compact">
          <span class="eyebrow">Scientific Method</span>
          <h2>Evidence Changes Direction</h2>
          <p class="sub">Research at Evolvaer does not exist to justify an idea; it provides the rigor required to proceed or stop.</p>
        </div>

        <!-- 4-step linear sequence -->
        <div class="method-steps">
          {methodology.map(m => (
            <div class="method-box">
              <div class="method-top">
                <span class="m-step">{m.step}</span>
                <span class="m-signal">{m.signal}</span>
              </div>
              <h4>{m.name}</h4>
              <p>{m.desc}</p>
            </div>
          ))}
        </div>

        <!-- Decision Gates Table -->
        <div class="matrix-card">
          <div class="matrix-header">
            <h4>Evaluation Protocol & Handoff Criteria</h4>
            <span class="matrix-note">Evidence-driven branching</span>
          </div>
          <div class="matrix-list">
            {decisionMatrix.map(gate => (
              <div class="matrix-row">
                <span class="gate-code" style={`color: ${gate.color}; border-color: ${gate.color}40;`}>{gate.code}</span>
                <strong class="gate-action">{gate.action}</strong>
                <p class="gate-condition">{gate.condition}</p>
                <span class="gate-arrow" style={`color: ${gate.color};`}>→</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. BOTTOM ACTION & SPECULATIVE RADAR -->
    <section class="section py-16 bg-deep text-white">
      <div class="container footer-cta-grid">
        <div>
          <span class="eyebrow text-teal">Inquiry & Collaboration</span>
          <h2 class="text-3xl font-bold tracking-tight mt-1 text-white">Have a research paper or problem domain to share?</h2>
          <p class="text-white/60 text-sm mt-2 max-w-xl">We welcome technical correspondence, data sets, and collaborative models from university research groups and industry labs.</p>
        </div>
        <div class="cta-btns">
          <a href="/contact?scope=research" class="btn-primary">Initiate Research Dialogue →</a>
          <a href="/what-we-do" class="btn-outline border-white/20 text-white">See How We Build</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  function setupFilters() {
    const buttons = document.querySelectorAll('#track-filters .filter-btn');
    const cards = document.querySelectorAll('#tracks-grid .track-card');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || filter === category) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  setupFilters();
  document.addEventListener('astro:page-load', setupFilters);
</script>

<style>
  /* Base Container Tokens */
  .container { max-width: 1220px; margin: 0 auto; padding: 0 1.5rem; }
  .section { padding: 5.5rem 0; }
  .surface-bg { background-color: var(--color-surface); }
  .border-y { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .text-teal { color: var(--color-teal); }
  .bg-deep { background-color: #060c14; }

  .eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-teal);
    display: block;
    margin-bottom: 0.5rem;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-teal) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 1. Hero Layout */
  .research-hero {
    position: relative;
    padding-top: 6.5rem;
    padding-bottom: 5.5rem;
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }
  .hero-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }
  .tag-row {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .mono-badge {
    font-family: monospace;
    font-size: 0.65rem;
    font-weight: bold;
    color: var(--color-primary);
    background: rgba(37, 99, 235, 0.08);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }
  .tag-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }
  .hero-text h1 {
    font-size: clamp(2.4rem, 4.2vw, 4rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.04em;
    line-height: 1.06;
    margin-bottom: 1.25rem;
  }
  .lead {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* Radar / Telemetry Card */
  .radar-card {
    background: #080c14;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5);
    color: #fff;
    font-family: monospace;
  }
  .radar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.65rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .radar-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22d3ee;
    box-shadow: 0 0 10px #22d3ee;
  }
  .radar-status { color: #22d3ee; flex-grow: 1; margin-left: 0.5rem; }
  .mono-date { color: rgba(255, 255, 255, 0.4); }
  .radar-display {
    position: relative;
    height: 14rem;
    margin: 1.5rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .concentric-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(34, 211, 238, 0.15);
  }
  .ring-1 { width: 13rem; height: 13rem; }
  .ring-2 { width: 7rem; height: 7rem; border-color: rgba(59, 130, 246, 0.2); }
  .crosshair-v { position: absolute; height: 100%; width: 1px; background: rgba(255, 255, 255, 0.08); }
  .crosshair-h { position: absolute; width: 100%; height: 1px; background: rgba(255, 255, 255, 0.08); }
  .radar-node {
    position: absolute;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: bold;
  }
  .node-1 { top: 20%; left: 30%; background: rgba(59, 130, 246, 0.2); border: 1px solid #3b82f6; color: #93c5fd; }
  .node-2 { bottom: 25%; right: 25%; background: rgba(34, 211, 238, 0.2); border: 1px solid #22d3ee; color: #a5f3fc; }
  .node-3 { top: 35%; right: 20%; background: rgba(168, 85, 247, 0.2); border: 1px solid #a855f7; color: #e9d5ff; }
  .radar-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.5);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 0.75rem;
  }
  .radar-meta span { color: #fff; }

  /* 2. Toolbar & Track Cards */
  .section-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .section-toolbar h2 {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
  }
  .filter-pills {
    display: flex;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    padding: 0.25rem;
    gap: 0.25rem;
  }
  .filter-btn {
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter-btn.active, .filter-btn:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.75rem;
  }
  .track-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.2s, border-color 0.2s;
  }
  .track-card:hover {
    transform: translateY(-3px);
    border-color: var(--card-accent);
  }
  .track-card-header {
    display: flex;
    justify-content: space-between;
    font-family: monospace;
    font-size: 0.7rem;
    margin-bottom: 1rem;
  }
  .track-code { font-weight: bold; color: var(--card-accent); }
  .track-state { color: var(--color-text-muted); background: var(--color-bg); padding: 0.2rem 0.5rem; border-radius: 4px; }
  .track-tag { font-size: 0.65rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.1em; color: var(--card-accent); }
  .track-card h3 { font-size: 1.3rem; font-weight: var(--weight-bold); margin: 0.4rem 0 0.75rem; }
  .track-desc { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.6; margin-bottom: 1.5rem; }
  .questions-tray {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
    margin-top: auto;
  }
  .tray-title { font-size: 0.68rem; font-weight: bold; text-transform: uppercase; color: var(--color-text-muted); display: block; margin-bottom: 0.5rem; }
  .questions-tray ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .questions-tray li { display: flex; gap: 0.6rem; font-size: 0.78rem; color: var(--color-text-main); line-height: 1.4; }
  .q-num { font-family: monospace; color: var(--card-accent); font-weight: bold; }

  /* 3. Methodology & Decision Gates */
  .section-header-compact { max-width: 650px; margin-bottom: 3.5rem; }
  .section-header-compact h2 { font-size: 2.2rem; font-weight: var(--weight-bold); letter-spacing: -0.03em; margin: 0.35rem 0; }
  .section-header-compact .sub { font-size: var(--text-sm); color: var(--color-text-muted); }

  .method-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 3.5rem;
  }
  .method-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.5rem;
  }
  .method-top { display: flex; justify-content: space-between; font-family: monospace; font-size: 0.7rem; margin-bottom: 0.5rem; }
  .m-step { font-weight: bold; color: var(--color-teal); }
  .m-signal { color: var(--color-text-muted); text-transform: uppercase; }
  .method-box h4 { font-size: 1rem; font-weight: bold; margin-bottom: 0.35rem; }
  .method-box p { font-size: var(--text-xs); color: var(--color-text-muted); line-height: 1.5; }

  .matrix-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }
  .matrix-header {
    background: var(--color-surface);
    padding: 1rem 1.75rem;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
  }
  .matrix-header h4 { font-size: var(--text-sm); font-weight: var(--weight-bold); }
  .matrix-note { font-size: 0.7rem; font-family: monospace; color: var(--color-text-muted); }
  .matrix-list { display: flex; flex-direction: column; }
  .matrix-row {
    display: grid;
    grid-template-columns: 5rem 10rem 1fr 2rem;
    align-items: center;
    padding: 1rem 1.75rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
  .matrix-row:last-child { border-bottom: none; }
  .gate-code { font-family: monospace; font-size: 0.7rem; font-weight: bold; border: 1px solid; padding: 0.15rem 0.4rem; border-radius: 4px; width: fit-content; }
  .gate-action { font-weight: var(--weight-semibold); color: var(--color-text-main); }
  .gate-condition { color: var(--color-text-muted); font-size: 0.8rem; }
  .gate-arrow { font-family: monospace; font-weight: bold; text-align: right; }

  /* 4. Bottom Action Banner */
  .footer-cta-grid {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .cta-btns { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* Buttons */
  .btn-primary {
    background: var(--color-primary);
    color: #fff !important;
    padding: 0.75rem 1.6rem;
    border-radius: 6px;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    display: inline-flex;
    transition: opacity 0.2s;
  }
  .btn-primary:hover { opacity: 0.92; }
  .btn-outline {
    background: var(--color-surface);
    color: var(--color-text-main);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1.6rem;
    border-radius: 6px;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    display: inline-flex;
  }

  @media (max-width: 900px) {
    .hero-layout { grid-template-columns: 1fr; }
    .matrix-row { grid-template-columns: 1fr; gap: 0.5rem; }
    .gate-arrow { display: none; }
  }
</style>