---
// src/components/ContactForm.astro
---

<div class="form-card">
  <div class="form-header">
    <h3>Project Inquiry Form</h3>
    <p>Tell us about your computational requirements, timelines, and technical scope.</p>
  </div>

  <form id="contact-form" class="styled-form">
    <!-- Replace with your actual Web3Forms access key from https://web3forms.com -->
    <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
    <input type="checkbox" name="botcheck" class="hidden-honeypot" tabindex="-1" autocomplete="off" />

    <div class="form-grid">
      <div class="field-group">
        <label for="name">Full Name *</label>
        <input type="text" id="name" name="name" required placeholder="e.g. Dr. Alex Vance" />
      </div>

      <div class="field-group">
        <label for="email">Work Email *</label>
        <input type="email" id="email" name="email" required placeholder="alex@company.com" />
      </div>
    </div>

    <div class="field-group">
      <label for="category">Area of Interest</label>
      <select id="category" name="category">
        <option value="systems">Custom Software & Systems Engineering</option>
        <option value="research">NLP & Machine Learning Research</option>
        <option value="ventures">Ventures & Technical Partnership</option>
        <option value="careers">Careers & Speculative Applications</option>
      </select>
    </div>

    <div class="field-group">
      <label for="message">Project Description *</label>
      <textarea id="message" name="message" rows="5" required placeholder="Provide an overview of your technical challenges, goals, and expected deliverables..."></textarea>
    </div>

    <button type="submit" id="submit-button" class="btn-submit">
      <span id="button-label">Send Message</span>
      <span id="button-spinner" class="spinner" aria-hidden="true"></span>
    </button>

    <div id="form-status" class="form-status" role="alert" style="display: none;"></div>
  </form>
</div>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const button = document.getElementById('submit-button') as HTMLButtonElement | null;
    const label = document.getElementById('button-label');
    const spinner = document.getElementById('button-spinner');
    const status = document.getElementById('form-status');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!button || !label || !spinner || !status) return;

      button.disabled = true;
      label.textContent = "Transmitting...";
      spinner.style.display = "inline-block";
      status.style.display = "none";

      const formData = new FormData(form);
      const json = JSON.stringify(Object.fromEntries(formData));

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: json
        });

        const result = await response.json();

        if (response.status === 200) {
          status.className = "form-status success";
          status.textContent = "Thank you. Your message has been received. An engineering lead will follow up shortly.";
          status.style.display = "block";
          form.reset();
        } else {
          throw new Error(result.message || "Failed to transmit message.");
        }
      } catch (err: any) {
        status.className = "form-status error";
        status.textContent = err.message || "An error occurred during submission. Please try again or reach out directly.";
        status.style.display = "block";
      } finally {
        button.disabled = false;
        label.textContent = "Send Message";
        spinner.style.display = "none";
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>

<style>
  .form-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
  }
  .form-header {
    margin-bottom: 2rem;
  }
  .form-header h3 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }
  .form-header p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: 0.4rem;
    line-height: 1.6;
  }
  .styled-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .hidden-honeypot {
    display: none;
  }
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  input, select, textarea {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-family: inherit;
    font-size: var(--text-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }
  .btn-submit {
    background-color: var(--color-primary);
    color: #ffffff;
    border: none;
    padding: 0.85rem 1.5rem;
    border-radius: 6px;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    transition: opacity 0.2s ease;
  }
  .btn-submit:hover:not(:disabled) {
    opacity: 0.92;
  }
  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .spinner {
    display: none;
    width: 14px;
    height: 14px;
    border: 2px solid #ffffff;
    border-bottom-color: transparent;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .form-status {
    padding: 0.85rem 1rem;
    border-radius: 6px;
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .form-status.success {
    background-color: rgba(16, 185, 129, 0.1);
    color: var(--color-teal);
    border: 1px solid var(--color-teal);
  }
  .form-status.error {
    background-color: rgba(249, 115, 22, 0.1);
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
  }
  @media (max-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>