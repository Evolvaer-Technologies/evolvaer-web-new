---
// src/components/BrandGallery.astro
const photos = [
  { tag: "Telecommunications", label: "Satellite Antenna Array", desc: "Long-range signal transmission and edge compute relays." },
  { tag: "Computation", label: "Accelerated Semiconductor Fabric", desc: "Hardware acceleration architectures for dense models." },
  { tag: "Infrastructure", label: "High-Density Data Centers", desc: "Redundant, low-latency compute topologies." },
  { tag: "Collaboration", label: "Interdisciplinary Research", desc: "Applied computer science and engineering alignment." }
];
---

<section class="gallery-section">
  <div class="container">
    <div class="gallery-header">
      <span class="eyebrow">Visual Archetypes</span>
      <h2>Real Technology. Real People. Real Impact.[cite: 1]</h2>
      <p class="sub">The physical and computational infrastructure backing our products[cite: 1].</p>
    </div>

    <div class="gallery-grid">
      {photos.map((photo) => (
        <div class="gallery-card">
          <div class="photo-placeholder">
            <div class="schematic-lines"></div>
            <span class="photo-tag">{photo.tag}</span>
          </div>
          <div class="card-caption">
            <h3>{photo.label}</h3>
            <p>{photo.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-section {
    padding: 5.5rem 1.5rem;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .gallery-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-teal);
    display: block;
    margin-bottom: 0.5rem;
  }
  h2 {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
  }
  .sub {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .gallery-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .gallery-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary);
  }
  .photo-placeholder {
    height: 170px;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(16, 185, 129, 0.08) 100%);
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .schematic-lines {
    position: absolute;
    inset: 0;
    background-size: 20px 20px;
    background-image: radial-gradient(circle, var(--color-border) 1px, transparent 1px);
    opacity: 0.6;
  }
  .photo-tag {
    position: relative;
    z-index: 1;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    background-color: var(--color-surface);
    color: var(--color-primary);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .card-caption {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card-caption h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
  }
  .card-caption p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>