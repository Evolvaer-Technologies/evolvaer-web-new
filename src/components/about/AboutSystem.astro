---
// src/components/about/AboutSystem.astro
const capabilities = [
  { num: "01", label: "Research", title: "Understand before building.", desc: "Investigate technologies, needs, markets and possibilities before making assumptions about the solution." },
  { num: "02", label: "Engineering", title: "Turn possibility into systems.", desc: "Prototype, test and engineer the technical foundations needed to transform promising ideas into usable technology." },
  { num: "03", label: "Ventures", title: "Build what deserves to exist.", desc: "Develop validated opportunities into products, platforms and companies capable of creating lasting value." }
];

const operatingModel = [
  { num: "01", title: "Research", desc: "Investigate emerging technologies, changing behaviours and meaningful problems before deciding what deserves to be built." },
  { num: "02", title: "Engineer", desc: "Turn promising ideas into prototypes, systems and technical foundations that can survive outside the laboratory." },
  { num: "03", title: "Build", desc: "When an opportunity proves valuable, we develop it into a product, platform or independent venture." },
  { num: "04", title: "Scale", desc: "Strengthen technology, product thinking and commercial foundations so useful ideas can grow sustainably." }
];
---

<section id="system" class="py-20 sm:py-24">
  <div class="evolvaer-container px-4 sm:px-6 lg:px-8">
    <!-- Why We Exist Statement -->
    <div class="max-w-4xl border-b border-[#0A1D2F]/10 pb-16 dark:border-white/10">
      <span class="text-[0.65rem] font-semibold uppercase tracking-[0.3em] text-[#10B981] dark:text-[#22D3EE]">Why we exist</span>
      <h2 class="mt-4 text-[clamp(2.2rem,4vw,3.8rem)] font-semibold leading-tight tracking-tight text-[#0A1D2F] dark:text-white">
        Technology moves quickly.<br />
        Useful innovation requires <span class="brand-gradient">something more.</span>
      </h2>
      <p class="mt-6 text-base leading-8 text-[#0A1D2F]/65 dark:text-white/50">
        New capabilities appear constantly, but not every breakthrough becomes a meaningful product. The difficult work lies in understanding where technology intersects with a genuine problem, a useful experience and a viable opportunity.
      </p>
    </div>

    <!-- 3 Connected Capabilities -->
    <div class="py-16">
      <h3 class="text-2xl font-semibold tracking-tight text-[#0A1D2F] dark:text-white">One company. Three connected capabilities.</h3>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {capabilities.map(c => (
          <div class="card p-8">
            <span class="text-xs font-bold text-[#2563EB] dark:text-[#3882F6]">{c.num} — {c.label}</span>
            <h4 class="mt-4 text-xl font-semibold">{c.title}</h4>
            <p class="mt-3 text-sm text-[#0A1D2F]/60 dark:text-white/45 leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- How We Operate (Connected System) -->
    <div class="border-t border-[#0A1D2F]/10 pt-16 dark:border-white/10">
      <h3 class="text-2xl font-semibold tracking-tight text-[#0A1D2F] dark:text-white">How ideas move through our system</h3>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {operatingModel.map((item, i) => (
          <div class="card p-6">
            <span class="text-xs font-bold text-[#10B981] dark:text-[#22D3EE]">Stage 0{i + 1}</span>
            <h4 class="mt-2 text-lg font-semibold">{item.title}</h4>
            <p class="mt-2 text-sm text-[#0A1D2F]/60 dark:text-white/45 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>