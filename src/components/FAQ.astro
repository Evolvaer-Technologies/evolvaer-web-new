---
// src/components/FAQ.astro
interface FAQItem {
  question: string;
  answer: string;
}

const faqs: FAQItem[] = [
  {
    question: "How does Evolvaer engage on technical client projects?",
    answer: "We structure engagements in disciplined phases: starting with a rapid 2-week architectural and feasibility spike, followed by milestone-based production engineering sprints. We deliver full source code ownership, infrastructure automation, and architecture documentation directly to your organization."
  },
  {
    question: "What stacks and infrastructures do you specialize in?",
    answer: "Our core engineering relies on TypeScript/JavaScript (Node.js), Next-generation zero-bundle runtimes, Python for scientific NLP/ML modeling, distributed database topologies, and cloud-native serverless platforms (Vercel, Cloudflare Workers, AWS)."
  },
  {
    question: "How do you ensure data security and compliance?",
    answer: "All enterprise engagements are conducted under comprehensive Non-Disclosure Agreements (NDAs). In multi-tenant platforms, we implement strict tenant database isolation, automated encryption at rest and in transit (TLS 1.3), and full adherence to UK GDPR and international data handling standards."
  },
  {
    question: "Are your incubated ventures open for investment or partnership?",
    answer: "Yes. Certain products developed in-house (such as Zentra and CribWise) are structured as independent entities open to targeted commercial pilot partners, institutional operators, and strategic co-investors. Inquiries can be submitted directly through our contact page."
  }
];
---

<section class="faq-section">
  <div class="faq-container">
    <div class="faq-header">
      <span class="eyebrow">Frequently Addressed</span>
      <h2>Operational Questions</h2>
      <p class="sub">Key technical specifications regarding our client workflow and architecture delivery.</p>
    </div>

    <div class="accordion-list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary class="faq-summary">
            <span class="faq-title">{faq.question}</span>
            <span class="faq-chevron" aria-hidden="true">+</span>
          </summary>
          <div class="faq-body">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: 5.5rem 1.5rem;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }
  .faq-container {
    max-width: 860px;
    margin: 0 auto;
  }
  .faq-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-teal);
    display: block;
    margin-bottom: 0.5rem;
  }
  h2 {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
  }
  .sub {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-top: 0.4rem;
  }
  .accordion-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .faq-item {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .faq-item[open] {
    border-color: var(--color-primary);
  }
  .faq-summary {
    list-style: none;
    padding: 1.5rem 1.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    user-select: none;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .faq-title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text-main);
  }
  .faq-chevron {
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--color-primary);
    transition: transform 0.2s ease;
    line-height: 1;
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(45deg);
  }
  .faq-body {
    padding: 0 1.75rem 1.5rem;
  }
  .faq-body p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
  }
</style>