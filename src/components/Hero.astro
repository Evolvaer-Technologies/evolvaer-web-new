---
// src/components/Hero.astro
---
<section class="hero-container bg-grid">
  <div class="ambient-glow"></div>
  <div class="ambient-glow-secondary"></div>
  
  <div class="hero-grid">
    <!-- Left Column: Core Value Proposition -->
    <div class="hero-content">
      <div class="badge-wrapper">
        <span class="pulse-dot"></span>
        <span class="badge">Next-Generation Engineering & Ventures</span>
      </div>

      <h1>
        Exploring what's <span class="text-primary">next.</span><br />
        Building what <span class="text-teal">matters.</span>
      </h1>

      <p class="lead">
        We research, engineer and commercialise emerging technologies into products and companies that solve real-world problems.
      </p>

      <div class="cta-group">
        <a href="/contact" class="btn-primary">
          <span>Initiate Project</span>
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/what-we-do" class="btn-outline">Explore Capabilities</a>
      </div>
    </div>

    <!-- Right Column: Brand Manifesto / Philosophy Card -->
    <div class="hero-visual-card">
      <div class="manifesto-header">
        <span class="manifesto-tag">Operating Philosophy</span>
        <span class="manifesto-dot"></span>
      </div>
      <div class="manifesto-body">
        <p class="manifesto-quote">
          "Technology is the medium, not the destination. True innovation happens at the intersection of rigorous research, human empathy, and disciplined execution."
        </p>
        
        <div class="pillars-row">
          <div class="pillar-pill">
            <span class="p-num">01</span>
            <span>Research</span>
          </div>
          <div class="pillar-pill">
            <span class="p-num">02</span>
            <span>Engineering</span>
          </div>
          <div class="pillar-pill">
            <span class="p-num">03</span>
            <span>Venture</span>
          </div>
        </div>

        <div class="term-divider"></div>
        <div class="status-row">
          <span class="status-indicator"></span>
          <span class="status-text">Focus: Real-World Impact & Sustainable Systems</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Vector Flow Waves -->
  <div class="wave-graphic-wrapper">
    <svg class="wave-svg" viewBox="0 0 1440 220" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M-100 80 C 300 180, 700 0, 1100 120 C 1300 180, 1500 60, 1600 100" stroke="var(--color-violet)" stroke-width="1.5" stroke-opacity="0.4" />
      <path d="M-100 110 C 250 20, 650 170, 1050 60 C 1250 0, 1450 140, 1600 80" stroke="var(--color-teal)" stroke-width="1.5" stroke-opacity="0.5" />
      <path d="M-100 140 C 350 210, 750 30, 1150 140 C 1350 200, 1550 50, 1600 110" stroke="var(--color-primary)" stroke-width="2" stroke-opacity="0.6" />
    </svg>
  </div>
</section>

<style>
  .hero-container {
    position: relative;
    padding: 8.5rem 1.5rem 7rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }
  
  .ambient-glow {
    position: absolute;
    top: 10%;
    left: 25%;
    width: 500px;
    height: 300px;
    background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
    opacity: 0.08;
    filter: blur(100px);
    pointer-events: none;
  }
  
  .ambient-glow-secondary {
    position: absolute;
    top: 25%;
    right: 20%;
    width: 450px;
    height: 280px;
    background: radial-gradient(circle, var(--color-teal) 0%, transparent 70%);
    opacity: 0.07;
    filter: blur(100px);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 1.5rem;
  }

  .badge-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.4rem 1.1rem;
    border-radius: 9999px;
    box-shadow: 0 4px 20px -4px rgba(0,0,0,0.05);
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-teal);
    box-shadow: 0 0 10px var(--color-teal);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 14px var(--color-teal); }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .badge {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-teal);
  }

  h1 {
    font-size: clamp(2.7rem, 4.8vw, 4.6rem);
    font-weight: var(--weight-bold);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .text-primary { 
    background: linear-gradient(135deg, var(--color-primary), #60a5fa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  .text-teal { 
    background: linear-gradient(135deg, var(--color-teal), #2dd4bf);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 580px;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: #ffffff !important;
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    padding: 0.8rem 1.8rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 8px 25px -6px rgba(37, 99, 235, 0.3);
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px -6px rgba(37, 99, 235, 0.4);
    opacity: 0.95;
  }

  .arrow-icon {
    width: 15px;
    height: 15px;
    transition: transform 0.25s ease;
  }

  .btn-primary:hover .arrow-icon {
    transform: translateX(3px);
  }

  .btn-outline {
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text-main);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    padding: 0.8rem 1.8rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .btn-outline:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    background-color: rgba(37, 99, 235, 0.02);
  }

  /* Right Column: Manifesto Card */
  .hero-visual-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.08);
    transition: transform 0.4s ease, border-color 0.3s ease;
  }

  .hero-visual-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
  }

  .manifesto-header {
    background: rgba(37, 99, 235, 0.03);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .manifesto-tag {
    font-size: 0.72rem;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
  }

  .manifesto-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .manifesto-body {
    padding: 2rem;
    text-align: left;
  }

  .manifesto-quote {
    font-size: var(--text-base);
    color: var(--color-text-main);
    line-height: 1.75;
    font-style: italic;
    margin-bottom: 1.75rem;
  }

  .pillars-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .pillar-pill {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.75rem 0.5rem;
    border-radius: 10px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
  }

  .p-num {
    font-family: monospace;
    font-size: 0.6rem;
    color: var(--color-teal);
  }

  .term-divider {
    height: 1px;
    background: var(--color-border);
    margin: 1.25rem 0;
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 10px #10b981;
  }

  .status-text {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    font-weight: var(--weight-semibold);
  }

  /* Wave Graphic */
  .wave-graphic-wrapper {
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 100%;
    height: 140px;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }
  
  .wave-svg {
    width: 100%;
    height: 100%;
  }

  /* Responsive Design */
  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }
    
    .hero-content {
      align-items: center;
      text-align: center;
    }

    .lead {
      margin: 0 auto;
    }

    .cta-group {
      justify-content: center;
    }

    .hero-visual-card {
      max-width: 500px;
      margin: 0 auto;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .cta-group {
      flex-direction: column;
      width: 100%;
    }
    .btn-primary, .btn-outline {
      width: 100%;
      justify-content: center;
    }
    .pillars-row {
      grid-template-columns: 1fr;
    }
  }
</style>