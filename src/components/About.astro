---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import BrandValues from '../components/BrandValues.astro';
import DigitalCard from '../components/DigitalCard.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="About | Evolvaer Technologies"
  description="The vision, history, and foundational leadership behind Evolvaer Technologies."
>
  <Navbar />
  <main>
    <section class="page-header bg-grid">
      <div class="container">
        <span class="eyebrow">Company Profile</span>
        <h1>Engineering with Purpose and Discipline</h1>
        <p class="lead">
          We research, engineer, and commercialise emerging technologies into scalable products and companies that solve real-world problems[cite: 1].
        </p>
      </div>
    </section>

    <BrandValues />

    <section class="about-content">
      <div class="container split-layout">
        <div class="narrative">
          <h2>Our Foundation</h2>
          <p>
            Evolvaer Technologies was established with a singular directive: bridge the chasm between deep academic computer science research and production-grade software execution.
          </p>
          <p>
            Rather than relying on ephemeral framework churn or bloated runtimes, our work emphasizes deterministic systems, mathematical validation, and architectural durability. We construct tools and foundations designed to support enterprise-critical workloads.
          </p>
          
          <h2 class="mt-4">Operating Philosophy</h2>
          <p>
            Every line of code deployed under our banner is measured against rigorous benchmarks: sub-millisecond execution speeds, minimal client footprint, absolute data integrity, and intuitive UI ergonomics.
          </p>
        </div>

        <div class="card-column">
          <DigitalCard />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: 5rem 1.5rem;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }
  .container {
    max-width: 1180px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-teal);
    display: block;
    margin-bottom: 0.5rem;
  }
  h1 {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl));
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 720px;
    margin: 0 auto;
  }
  .about-content {
    padding: 5rem 1.5rem;
  }
  .split-layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }
  .narrative h2 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    margin-bottom: 1rem;
  }
  .narrative p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }
  .mt-4 {
    margin-top: 2rem;
  }
  @media (max-width: 900px) {
    .split-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>