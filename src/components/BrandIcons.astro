---
// src/components/BrandIcons.astro
interface Props {
  name: 'research' | 'engineer' | 'build' | 'scale' | 'impact' | 'collaborate';
  size?: number;
  className?: string;
}

const { name, size = 32, className = '' } = Astro.props;
---

<span class={`icon-wrapper ${className}`} style={`width: ${size}px; height: ${size}px;`}>
  {name === 'research' && (
    /* Code / Angle Brackets with Slash */
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="24" cy="24" r="20" opacity="0.3" stroke="var(--color-border)" />
      <path d="M18 16L10 24L18 32" stroke="var(--color-teal)" />
      <path d="M30 16L38 24L30 32" stroke="var(--color-teal)" />
      <path d="M26 12L22 36" stroke="var(--color-primary)" />
    </svg>
  )}

  {name === 'engineer' && (
    /* Technical Gear / Cog */
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="24" cy="24" r="7" stroke="var(--color-primary)" />
      <path d="M24 6V11M24 37V42M6 24H11M37 24H42M11.3 11.3L14.8 14.8M33.2 33.2L36.7 36.7M11.3 36.7L14.8 33.2M33.2 14.8L36.7 11.3" stroke="var(--color-teal)" />
    </svg>
  )}

  {name === 'build' && (
    /* Stacked Architecture Layers */
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 8L40 16L24 24L8 16L24 8Z" stroke="var(--color-primary)" />
      <path d="M8 24L24 32L40 24" stroke="var(--color-teal)" />
      <path d="M8 32L24 40L40 32" stroke="var(--color-teal)" />
    </svg>
  )}

  {name === 'scale' && (
    /* Upward Growth Vector with Step Graph */
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 38L22 26L30 32L40 14" stroke="var(--color-primary)" />
      <path d="M30 14H40V24" stroke="var(--color-teal)" />
      <path d="M8 42H42" stroke="var(--color-border)" stroke-dasharray="2 2" />
    </svg>
  )}

  {name === 'impact' && (
    /* Concentric Target Focus */
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="24" cy="24" r="18" stroke="var(--color-border)" stroke-dasharray="4 4" />
      <circle cx="24" cy="24" r="11" stroke="var(--color-teal)" />
      <circle cx="24" cy="24" r="4" fill="var(--color-primary)" stroke="var(--color-primary)" />
    </svg>
  )}

  {name === 'collaborate' && (
    /* Network Cluster / Nodes */
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="24" cy="14" r="6" stroke="var(--color-primary)" />
      <circle cx="12" cy="32" r="5" stroke="var(--color-teal)" />
      <circle cx="36" cy="32" r="5" stroke="var(--color-teal)" />
      <path d="M19 18L14 28M29 18L34 28M17 32H31" stroke="var(--color-border)" stroke-dasharray="2 2" />
    </svg>
  )}
</span>

<style>
  .icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  svg {
    width: 100%;
    height: 100%;
  }
</style>